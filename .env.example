# Datasource
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/konecta-store-stock
SPRING_DATASOURCE_USERNAME=apple
SPRING_DATASOURCE_PASSWORD=

# Eureka
EUREKA_SERVER_URL=http://localhost:8761/eureka/
EUREKA_CLIENT_ENABLED=true

# Must match the KONECTA-SECURITY-SERVICE HS256 signing secret.
JWT_SECRET=change-me-to-the-security-service-shared-secret

# Direct URL fallback for local/non-Eureka dev
SECURITY_SERVICE_URL=http://localhost:8091

# Server
SERVER_PORT=8092

# Kafka (optional, no-op publisher when unset)
KAFKA_BOOTSTRAP_SERVERS=

TZ=Africa/Maputo

# S3 bucket for product photos / shop logo & cover (private bucket, all
# access via presigned URLs — see common.storage.AwsS3Config).
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_S3_BUCKET=konecta-media-564956047797
AWS_S3_STORES_PREFIX=stores/
AWS_S3_PRODUCTS_PREFIX=products/
AWS_S3_PRESIGN_PUT_TTL_SECONDS=300
AWS_S3_PRESIGN_GET_TTL_SECONDS=3600
